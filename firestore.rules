rules_version = '2';

// Firestore Security Rules for Ocean Air Care ReviewPro
// - Public users (unauthenticated) can READ reviews & categories.
// - Only authenticated admin users can WRITE.
// - Analytics: aggregate document is writable by anyone (client-side increment only)
//   but structured as a single doc to make abuse limited. Consider rate-limiting via
//   Cloud Functions in production if you need stricter guarantees.

service cloud.firestore {
  match /databases/{database}/documents {

    // Public read
    match /reviews/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Analytics aggregate doc
    match /analytics/{docId} {
      allow read: if request.auth != null;
      allow write: if true;   // increments only from client — tighten with Cloud Functions in prod
    }
  }
}
